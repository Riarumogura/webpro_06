<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= newdata.name %></title>
</head>
<body>
  <h2><%= newdata.name %>の詳細</h2>
  <table>
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>ID</td><td><%= newdata.code %></td></tr>
    <tr><td>駅名</td><td><%= newdata.name %></td></tr>
    <tr><td>乗り換え線</td><td><%= newdata.change %></td></tr>
    <tr><td>乗降客数</td><td><%= newdata.passengers %>人</td></tr>
    <tr><td>東京駅からの距離</td><td><%= newdata.distance %></td></tr>
  </table>
  <a href="/keiyo2/edit/<%= id %>">編集</a>
  <a href="/keiyo2/delete/<%= id %>">削除</a>
  <a href="/keiyo2">駅一覧に戻る</a>
</body>
</html>