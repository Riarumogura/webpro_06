<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= jujutsu.name %>の詳細</title>
</head>
<body>
  <h2 style="text-align:center;"><%= jujutsu.name %> の詳細</h2>
  <style>
    table { margin:auto; }
  </style>
  <table border="1" cellpadding="10">
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>ID</td><td><%= jujutsu.id %></td></tr>
    <tr><td>名前</td><td><%= jujutsu.name %></td></tr>
    <tr><td>階級</td><td><%= jujutsu.rank %></td></tr>
    <tr><td>術式</td><td><%= jujutsu.jutsushiki %></td></tr>
    <tr><td>領域</td><td><%= jujutsu.ryoiki %></td></tr>
  </table>
  <p style="text-align:center;"><a href="/jujutsu/edit/<%= id %>">編集</a></p>
  <p style="text-align:center;">
    <a href="/jujutsu/delete/<%= id %>" onclick="return confirm('本当に削除しますか？');">削除</a>
  </p>
  <p style="text-align:center;"><a href="/jujutsu">一覧に戻る</a></p>
</body>
</html>