<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Minecraftデータベース</title>
</head>
<body>
  <h2 style="text-align:center;">Minecraft登録座標一覧</h2>
  <style>
    body {
      text-align: center;
    }
    table {
      margin: auto;
      border-collapse: collapse;
      white-space: nowrap;
      min-width: 100%;
    }
    th, td {
      padding: 10px;
      text-align: center;
      border: 1px solid #666;
    }
    th {
      background-color: #f2f2f2;
    }
  </style>
  <div>
  <table border="1" cellpadding="15">
    <tr><th>No.</th><th>名前</th><th>X座標</th><th>y座標</th><th>Z座標</th><th></th></tr>
      <% let number = 0 %>
      <% for( let row of zahyo ) { %>
        <tr><td><%= row.id %></td>
        <td><a href="/zahyo/<%= number %>"><%= row.name %></a></td>
        <td><%= row.x %></td>
        <td><%= row.y %></td>
        <td><%= row.z %></td>
        <td>
          <form action="/zahyo/delete/<%= number %>" onsubmit="return confirm('本当に「<%= row.name %>」の座標を削除しますか？');">
            <button type="submit">❌</button>
        </td>
        </tr>
        <% number += 1 %>
      <% } %>
  </table>
  </div>
  <p style="text-align:center;"><a href="/zahyo/create">座標を追加する</a></p>
  <p style="text-align:center;"><a href="/">ホームに戻る</a></p>
</body>
</html>