<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Minecraftデータベース</title>
</head>
<body>
  <h2>Minecraft座標データベース</h2>
  <h3>Minecraft登録座標一覧</h3>
  <table>
    <tr><th>ID</th><th>名前</th><th>X座標</th><th>y座標</th><th>Z座標</th></tr>
      <% let number = 0 %>
      <% for( let row of zahyo ) { %>
        <tr><td><%= row.id %></td>
        <td><a href="/zahyo/<%= number %>"><%= row.name %></a></td>
        <td><%= row.x %></td>
        <td><%= row.y %></td>
        <td><%= row.z %></td>
        </tr>
        <% number += 1 %>
      <% } %>
  </table>
  <a href="/zahyo/create">追加</a>
</body>
</html>