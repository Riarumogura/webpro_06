<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>編集: <%= jujutsu.name %></title>
</head>
<body>
  <h2 style="text-align:center;"><%= jujutsu.name %> の編集</h2>
  <style>
    div { text-align:center; }
    table { margin:auto; }
  </style>
  <form action="/jujutsu/update/<%= id %>" method="POST">
    <table border="1" cellpadding="10">
      <tr><th>項目</th><th>データ</th></tr>
      <tr><td>ID</td><td><input type="number" name="id" value="<%= jujutsu.id %>"></td></tr>
      <tr><td>名前</td><td><input type="text" name="name" value="<%= jujutsu.name %>"></td></tr>
      <tr><td>階級</td><td><input type="text" name="rank" value="<%= jujutsu.rank %>"> (特級, 1級...)</td></tr>
      <tr><td>術式</td><td><input type="text" name="jutsushiki" value="<%= jujutsu.jutsushiki %>"></td></tr>
      <tr><td>領域</td><td><input type="text" name="ryoiki" value="<%= jujutsu.ryoiki %>"></td></tr>
    </table>
    <div><input type="submit" value="変更" onclick="return confirm('変更しますか？');"></div>
  </form>
  <p style="text-align:center;"><a href="/jujutsu">一覧に戻る</a></p>
</body>
</html>