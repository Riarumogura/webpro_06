<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= zahyo.name %></title>
</head>
<body>
  <h2 style="text-align:center;"><%= zahyo.name %>の編集</h2>
  <style>
    div{
        text-align:center;
    }
    table{
        margin:auto;
    }
  </style>
  <form action="/zahyo/update/<%= zahyo.id - 1 %>" method="POST">
    <table border="1" cellpadding="10">
      <tr><th>項目</th><th>データ</th></tr>
      <tr><td>No.</td><td><input type="number" name="id" value="<%= zahyo.id %>"></td></tr>
      <tr><td>名前</td><td><input type="text" name="name" value="<%= zahyo.name %>"></td></tr>
      <tr><td>X座標</td><td><input type="number" name="x" value="<%= zahyo.x %>"></td></tr>
      <tr><td>Y座標</td><td><input type="number" name="y" value="<%= zahyo.y %>"></td></tr>
      <tr><td>Z座標</td><td><input type="number" name="z" value="<%= zahyo.z %>"></td></tr>
      <tr><td>メモ</td><td><input type="text" name="memo" value="<%= zahyo.memo %>"></td></tr>
    </table>
    <div><input type="submit" value="変更" onclick="return confirm('本当に「<%= zahyo.name %>」を変更しますか？');"></div>
  </form>
  <p style="text-align:center;"><a href="/zahyo/">座標一覧に戻る</a></p>
</body>
</html>